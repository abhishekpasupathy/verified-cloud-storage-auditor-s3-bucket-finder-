# Used by the Vercel agentic endpoint and optional local Python agent (agent.py).
# Do not commit a real key.
GROQ_API_KEY=
# Optional: overrides the default Groq tool-calling model.
GROQ_MODEL=llama-3.3-70b-versatile

# Required for email authentication and persistent, user-scoped scan history.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
